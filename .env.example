NODE_ENV=development

# Server
SERVER_PORT=3000
SERVER_SECRET=your_server_secret
CLIENT_SECRET=your_client_secret
SESSION_SECRET=your_session_secret
SESSION_MAX_AGE=86400000
DEFAULT_JWT_AUTHENTICATION=true
AUTHENTICATION_PLUGIN=path_to_authentication_plugin
PLATFORM_PLUGINS=plugin1,plugin2
PLATFORM_PLUGINS_PATH=path_to_platform_plugins

# Database
DB_URI=mongodb://username:password@localhost:27017/mcp-hub?authSource=admin
MONGODB_DB=mcp-hub

# Security
SECURE_COOKIES=true

# Static files
CLIENT_DIR=path_to_client_build

# Changelog
CHANGELOG_PATH=./CHANGELOG.md

# Admin bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PREFIX=aloha_

# Logging
LOG_LEVEL=info
SHOW_SENSITIVE_DATA=false

# MCP Session
MCP_SESSION_TTL_MS=1800000
MCP_SESSION_REAP_INTERVAL_MS=300000

# A2A
A2A_TASK_TTL_MS=1800000

# OIDC Authentication
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_JWKS={"keys":[]}
OIDC_CODE_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPE=openid email profile
OIDC_HOME=http://localhost:5173/
OIDC_USE_IDENTITY_PROPAGATION_SERVICE=false
OIDC_IDENTITY_PROPAGATION_SERVICE_PATH=/identity-propagation
OIDC_IDENTITY_PROPAGATION_REGISTRAR_PATH=/identity-registrar
OIDC_UNKNOWN_USERS_ALLOW=false
OIDC_UNKNOWN_USERS_PERMISSIONS=CLIENTS_READ,SERVERS_READ