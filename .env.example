NODE_ENV=production
AUTHENTICATION_PLUGIN=path_to_authentication_plugin
CLIENT_DIR=path_to_client

SERVER_PORT=8100

# app
MONGODB_URI=mongodb://username:password@localhost:27017/mcp-hub?authSource=admin
CLIENT_SECRET=your_client_secret
CAS_URL=https://webgate.ec.europa.eu/cas/

# mongodb
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password_for_root

# graphana
GRAPHANA_URL=graphana_url
GRAPHANA_USERNAME=graphana_user
GRAPHANA_PASSWORD=graphana_password
