{
  "name": "server",
  "version": "4.2.1",
  "description": "The backend server of ALOHA",
  "author": "Fabrizio ZARO <fabrizio.zaro@ec.europa.eu>",
  "homepage": "",
  "license": "EUPL-1.2",
  "main": "lib/server.js",
  "type": "module",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "e2e": "NODE_ENV=e2e tsx watch --inspect src/server.ts",
    "dev": "tsx watch --inspect src/server.ts",
    "dev-brk": "tsx watch --inspect-brk src/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias",
    "prebuild": "rm -rf ./dist/*",
    "pretest": "node tests/check-env.cjs",
    "test": "DOTENV_CONFIG_PATH=tests/.env.test pnpm mocha --exit",
    "test:coverage": "c8 pnpm test",
    "start": "NODE_ENV=production node ./dist/server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@ver0/deep-equal": "^2.0.1",
    "aloha-shared": "link:../aloha-shared",
    "clone-deep": "^4.0.1",
    "connect-mongo": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "eventsource": "^4.1.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "get-port": "^7.2.0",
    "http-proxy-middleware": "^4.0.0",
    "jose": "^6.2.3",
    "minisearch": "^7.2.0",
    "mongodb": "^7.2.0",
    "node-cache": "^5.1.2",
    "node-fetch-native": "^1.6.7",
    "openid-client": "^6.8.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "15.1.3",
    "typed-inject": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/clone-deep": "^4.0.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.18",
    "@types/pg": "^8.20.0",
    "@types/sinon": "^21.0.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "eslint": "^10.3.0",
    "mocha": "^11.7.5",
    "mongodb-memory-server": "^11.1.0",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "undici": "^8.2.0"
  }
}
