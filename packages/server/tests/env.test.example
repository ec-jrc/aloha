# Environment for unit tests only.
# `pnpm test` loads this file via DOTENV_CONFIG_PATH, so the developer's
# packages/server/.env never leaks into the test run.
# Copy to tests/.env.test to customise; tests/.env.test is git-ignored.
# Keep it minimal: unit tests set their own env vars.

# Secrets required by provideEnvVars (db-setup.cjs also sets them; kept here
# so any module-level dotenv load sees valid values).
SERVER_SECRET=test-server-secret
CLIENT_SECRET=test-client-secret
SESSION_SECRET=test-session-secret

# Database: mongodb-memory-server overrides DB_URI in mochaGlobalSetup,
# but the URI scheme must resolve to a supported type.
DB_URI=mongodb://127.0.0.1:27017/ALOHA_TEST

# Logging: quiet by default; override locally if debugging tests.
LOG_LEVEL=warn

# Production mode off.
NODE_ENV=test

# Do not load developer auth/platform plugins or OIDC during tests.
AUTHENTICATION_PLUGIN=
PLATFORM_PLUGINS=
PLATFORM_PLUGINS_PATH=
OIDC_ENABLED=false
OIDC_USE_IDENTITY_PROPAGATION_SERVICE=false
